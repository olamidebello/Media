{
  "name": "africa-media-hub",
  "version": "1.0.0",
  "description": "Africa Creates. The World Connects.",
  "author": "Africa Media Hub",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.africamedia.hub",
    "productName": "Africa Media Hub",
    "files": [
      "main.cjs",
      "package.json",
      "preload.cjs",
      "tv-install.cjs",
      "tv-discovery.cjs",
      "camera-discovery.cjs",
      "lan-devices.cjs"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    },
    "artifactName": "africa-media-${os}.${ext}"
  }
}
